{
    "name": "apiverve/wordrhymes",
    "description": "Rhyming Words finds matching rhymes for any query word, returning a list of rhyming words and a total match count. Paid plans can adjust the maximum number of rhymes returned.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "wordrhymes",
        "rhyming words api",
        "find rhymes",
        "word rhyme lookup",
        "rhyming dictionary",
        "english word rhymes"
    ],
    "homepage": "https://apiverve.com/marketplace/wordrhymes?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/wordrhymes",
        "source": "https://github.com/apiverve/wordrhymes-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Wordrhymes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Wordrhymes\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
